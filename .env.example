APP_NAME=SurplusLink AI API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
POSTGRES_DB=surpluslink
POSTGRES_USER=surpluslink
POSTGRES_PASSWORD=replace_with_secure_password
# Prefer individual settings above; SQLAlchemy safely handles special characters.
# Optional override: use URL-encoded credentials matching POSTGRES_PASSWORD.
# DATABASE_URL=postgresql+psycopg://surpluslink:replace_with_secure_password@db:5432/surpluslink
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
DEMO_MODE=true
# GroqCloud hosted inference; no weights are downloaded.
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=
AI_TIMEOUT_SECONDS=20
